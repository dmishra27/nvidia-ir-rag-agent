 <head>
  <script>
(function () {
  const CAROUSEL_ID = 'home-wmfg-carousel';
  const FADE_CLASS  = 'nv-fade-ready';

  /* Containers to fade in, by id -> delay(ms). Add a line per slide. */
  const FADE_TARGETS = {
    'show_with_video_1': 3000
  };

  /* Inject styles once. Hide rule is plain #id (specificity 1,0,0);
     show rule is #id.nv-fade-ready (1,1,0) so it wins. Transition lives
     on the show state ONLY, so it fades IN but snaps hidden on reset.
     This is in <head> before the container is parsed, so no load flash. */
  if (!document.getElementById('nv-fade-styles')) {
    const ids = Object.keys(FADE_TARGETS);
    const hide = ids.map(id => `#${id}{opacity:0;visibility:hidden;}`).join('');
    const show = ids.map(id =>
      `#${id}.${FADE_CLASS}{opacity:1;visibility:visible;transition:opacity 800ms ease;}`
    ).join('');
    const style = document.createElement('style');
    style.id = 'nv-fade-styles';
    style.textContent = hide + show;
    document.head.appendChild(style);
  }

  let activeTimers = [];

  function onSlideActivated(slide) {
    /* Cancel pending fades so they can't fire early on fast re-entry */
    activeTimers.forEach(clearTimeout);
    activeTimers = [];

    Object.keys(FADE_TARGETS).forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      el.classList.remove(FADE_CLASS);          // instant hide (base rule, no transition)
      if (slide.contains(el)) {                 // target lives in the now-active slide
        activeTimers.push(
          setTimeout(() => el.classList.add(FADE_CLASS), FADE_TARGETS[id])
        );
      }
    });
  }

  function init() {
    const carousel = document.getElementById(CAROUSEL_ID);
    if (!carousel) return;

    const observer = new MutationObserver(mutations => {
      mutations.forEach(({ target, attributeName }) => {
        if (
          attributeName === 'class' &&
          target.classList.contains('cmp-carousel__item--active') &&
          target.closest(`#${CAROUSEL_ID}`)
        ) {
          onSlideActivated(target);
        }
      });
    });

    observer.observe(carousel, {
      attributes: true,
      attributeFilter: ['class'],
      subtree: true
    });

    const firstActive = carousel.querySelector('.cmp-carousel__item--active');
    if (firstActive) onSlideActivated(firstActive);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
