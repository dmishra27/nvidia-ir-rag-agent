# Copy to .env and fill in real values. See README.md's ".env variables"
# table for what each one is used for. Never commit the real .env (it's
# gitignored).

# LLM / re-ranker APIs
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# Postgres (matches docker-compose.yml's `postgres` service defaults)
POSTGRES_URL=postgresql://nvidia_ir:nvidia_ir_pass@localhost:5432/nvidia_ir_db
POSTGRES_USER=nvidia_ir
POSTGRES_PASSWORD=nvidia_ir_pass
POSTGRES_DB=nvidia_ir_db

# Qdrant (local + Render/prod)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_CLOUD_URL=
QDRANT_CLOUD_API_KEY=

ENABLE_PHOENIX=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# MLflow (no dedicated docker-compose service -- run your own local server)
MLFLOW_TRACKING_URI=http://localhost:5000

# OpenTelemetry -> Jaeger tracing (api/telemetry.py, optional; off by default
# so unit tests and plain `uvicorn api.main:app` runs don't need a Jaeger
# collector listening)
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=nvidia-ir-rag-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Re-ranker mode: live_fast | live_quality | live_frontier | benchmark | fallback
RERANKER_MODE=live_fast

# Slack bot (Day 13, Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
FASTAPI_BASE_URL=http://localhost:8000

# Optional
WANDB_API_KEY=
WANDB_PROJECT=
OLLAMA_BASE_URL=http://localhost:11434
NGROK_AUTHTOKEN=
